FROM python:3.11-slim

# Install basic system dependencies for computer vision
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    ffmpeg \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml ./
COPY src/ ./src/

# Install Python dependencies (minimal for CV testing)
RUN pip install --no-cache-dir \
    opencv-python \
    opencv-contrib-python \
    numpy \
    ultralytics \
    apriltag \
    scikit-image \
    shapely \
    pillow

# Create non-root user
RUN useradd --create-home --shell /bin/bash batchgrids
USER batchgrids

# Expose port
EXPOSE 8000

# Default command
CMD ["python", "-c", "print('BatchGrids Computer Vision Test Container Ready')"]